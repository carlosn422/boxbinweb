{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "types": []
  },
  "include": [
    "supabase/functions/_shared/*.ts",
    "supabase/functions/boxbin-copilot/*.ts",
    "supabase/functions/boxbin-image/*.ts",
    "supabase/functions/boxbin-copilot-voice/*.ts",
    "tests/edge-globals.d.ts",
    "supabase/functions/boxbin-billing/*.ts",
    "supabase/functions/boxbin-billing-webhook/*.ts",
    "supabase/functions/cancel-subscription/*.ts",
    "supabase/functions/upgrade-subscription/*.ts",
    "supabase/functions/validate-coupon/*.ts",
    "supabase/functions/move-image-to-final/**/*.ts",
    "supabase/functions/move-image-to-final-images/**/*.ts"
  ]
}
