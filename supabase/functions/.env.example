# Server secrets only. Never prefix these with VITE_ or put them in the frontend .env.
GEMINI_API_KEY=
STRIPE_SECRET_KEY=
COPILOT_CHAT_MODEL=gemini-2.5-flash
COPILOT_IMAGE_MODEL=gemini-2.5-flash-image
# SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are supplied by Supabase Edge runtime.

# Gemini Live: audio nativo, con la misma GEMINI_API_KEY del servidor.
# Debe estar disponible para tu proyecto de Google. No usar el modelo de texto aquí.
COPILOT_LIVE_MODEL=gemini-3.8-live
COPILOT_LIVE_VOICE=Kore
